{
  "name": "dsh-session-handoff",
  "version": "0.3.0",
  "description": "Hand your long DSH session over to a fresh one: /handoff summarizes the recent conversation with an LLM, creates a clean new session in the same workspace, injects the summary as its first message, and auto-opens it. The origin session is unchanged.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./typert": "./lib/typert.host.mjs"
  },
  "files": [
    "index.mjs",
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "prepack": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "handoff",
    "session",
    "context",
    "summarize",
    "continue",
    "cordis-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5 || ^0.1.1-rc.2 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5 || ^0.1.1-rc.2 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "homepage": "https://github.com/MountBatten718/dsh-session-handoff#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:MountBatten718/dsh-session-handoff.git"
  },
  "bugs": {
    "url": "https://github.com/MountBatten718/dsh-session-handoff/issues"
  }
}
